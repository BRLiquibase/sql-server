# Copy this file to .env and fill in your values.
# Liquibase reads .env automatically from the working directory.
# Do not commit a real .env file, keep secrets out of git.

LB_URL=jdbc:sqlserver://YOUR_HOST:1433;databaseName=YOUR_DB;encrypt=true;trustServerCertificate=true
LB_USER=YOUR_USERNAME
LB_PASSWORD=YOUR_PASSWORD
LIQUIBASE_LICENSE_KEY=YOUR_LICENSE_KEY
